// (before anchor 31)
    // OneiOS: oneios-audio-ring=FRAMES, the speaker's ring (960..8192; best a whole number of 240-frame periods).
    PE_parse_boot_argn("oneios-audio-ring", &oneios_speaker_ring, sizeof(oneios_speaker_ring));
    if (oneios_speaker_ring < 4 * PeriodFrames) oneios_speaker_ring = 4 * PeriodFrames;
