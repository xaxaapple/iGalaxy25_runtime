        // OneiOS: the speaker takes a period as it starts (the HAL has written it a safety offset of one period
        // ahead), the others once it has passed.
        const bool early = speakerEngine();
        const uint64_t deadline = startTime + absolute(done + (early ? 0 : PeriodFrames));
// (before anchor 26)
        if (early) oneiosSpeakerPeriod(deadline, done);
        // OneiOS: a period over the ring's end goes through `wrapped`, in two parts.
        int16_t wrapped[PeriodFrames * 2];
        const uint32_t first = uint32_t(done % ringFrames), part = ringFrames - first < PeriodFrames ? ringFrames - first : PeriodFrames;
        int16_t *at = part == PeriodFrames ? buffer + first * ch : wrapped;
        if (at == wrapped && !isInput) {
            memcpy(wrapped, buffer + first * ch, part * 2 * ch);
            memcpy(wrapped + part * ch, buffer, (PeriodFrames - part) * 2 * ch);
