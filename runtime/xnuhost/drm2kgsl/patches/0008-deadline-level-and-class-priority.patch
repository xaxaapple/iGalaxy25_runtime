+/* ONEIOS (0008): a background context's queue, at its submission: KGSL's lowest level while the context is told so
+ * (drm2kgsl_renderer_set_class), none otherwise; an ioctl only where that changes. */
+static void
+oneios_lowest_update(struct kgsl_context *kctx, uint32_t drawctxt_id)
+{
+   unsigned slot = 4;
+   for (unsigned i = 0; i < 4 && slot == 4; i++)
+      if (kctx->oneios_low_queue[i] == drawctxt_id)
+         slot = i;
+   for (unsigned i = 0; i < 4 && slot == 4; i++)
+      if (!kctx->oneios_low_queue[i]) {
+         kctx->oneios_low_queue[i] = drawctxt_id;
+         kctx->oneios_low_on[i] = false;
+         slot = i;
+      }
+   const bool want = kctx->oneios_lowest;
+   if (slot == 4) {                        /* more queues than followed: say it every time */
+      kgsl_set_pwr_level(kctx->base.fd, drawctxt_id, want, KGSL_CONSTRAINT_PWR_MIN);
+      return;
+   }
+   if (want != kctx->oneios_low_on[slot] && kgsl_set_pwr_level(kctx->base.fd, drawctxt_id, want, KGSL_CONSTRAINT_PWR_MIN))
+      kctx->oneios_low_on[slot] = want;
+}
