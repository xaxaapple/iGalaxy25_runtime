+/* ONEIOS (0008): the level from xnuhost's policy (src/gpu3d_kgsl.c). The top: the deadline queues carry KGSL's highest level at
+ * their next submission and the hold runs to DRM2KGSL_PWR_HOLD_MS after this call. The governor's: their constraint goes off at
+ * their next submission and the hold stops now (KGSL lets the last renewal expire, its idle timer, then the governor decides).
+ * Replaces 0002-0006's rules: every render-server submission at the top and 150 ms after it, whatever the frame needed. */
+void
+drm2kgsl_renderer_set_level(int top)
+{
+   __atomic_store_n(&g_oneios_top, top != 0, __ATOMIC_RELEASE);
+   __atomic_store_n(&g_oneios_driven, true, __ATOMIC_RELEASE);
+   if (top) {
+      oneios_hold_extend();
+      return;
+   }
+   pthread_mutex_lock(&g_hold.lock);
+   const uint64_t now = oneios_now_ns();
+   if (g_hold.until > now)
+      g_hold.until = now;
+   pthread_mutex_unlock(&g_hold.lock);
+}
