# A stand-in for the phone's touchscreen and side keys (xnuhost --input-script FILE; format: src/input_script.c).
# The axes are a 1440 x 3120 panel's, as the S24 Ultra's touchscreen driver is expected to state them (not read
# from the phone yet); the guest scales whatever range the device states to its screen.
abs 0x2f 0 9             # ABS_MT_SLOT
abs 0x39 0 65535         # ABS_MT_TRACKING_ID
abs 0x35 0 1439 10       # ABS_MT_POSITION_X
abs 0x36 0 3119 10       # ABS_MT_POSITION_Y
# A pen, as a portrait digitizer of the panel's size might state it (the S24 Ultra's "sec_e-pen" ranges are not read
# yet): the pen- lines are left out unless xnuhost runs with --set pen=auto, which also gives the guest oneios-pen=1.
pen-abs 0x00 0 11519     # ABS_X
pen-abs 0x01 0 24959     # ABS_Y
pen-abs 0x18 0 4095      # ABS_PRESSURE
pen-abs 0x19 0 255       # ABS_DISTANCE
pen-abs 0x1a -63 63      # ABS_TILT_X, degrees (no resolution)
pen-abs 0x1b -63 63      # ABS_TILT_Y
ready                    # the guest's virtio-input driver has started the device
wait 3000
tap 720 1560             # the middle of the screen
wait 1000
swipe 720 3100 720 1500 300   # up from the bottom edge: Home
wait 1000
key 115                  # volume up
wait 500
key 114                  # volume down
wait 500
key 116                  # power
wait 2000
pen-hover 5760 12480 300 120              # the pen comes near the middle of the screen, 120/255 up
pen-hover 5900 12600 200 40               # lower
pen-stroke 2000 8000 9000 8000 480 300 3800      # a light-to-hard stroke across, the pen upright
pen-hover 9000 9000 200 60
pen-stroke 2000 16000 9000 18000 480 2000 2000 40 -30   # an even stroke, the pen leaning right and towards the top
pen-button 1                              # the side button while hovering
pen-hover 6000 20000 300 80
pen-button 0
pen-out                                   # the pen leaves
wait 3000
repeat
