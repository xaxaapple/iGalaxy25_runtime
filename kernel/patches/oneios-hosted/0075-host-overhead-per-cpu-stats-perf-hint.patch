+int oneios_clpc_thread_role(thread_t thread);
+int
+oneios_clpc_thread_role(thread_t thread)
+{
+	if (thread == THREAD_NULL || get_threadtask(thread) == TASK_NULL) {
+		return -1;
+	}
+	if (proc_get_effective_thread_policy(thread, TASK_POLICY_DARWIN_BG)) {
+		return TASK_DARWINBG_APPLICATION;
+	}
+	int role = proc_get_effective_task_policy(get_threadtask(thread), TASK_POLICY_ROLE);
+	if ((role == TASK_UNSPECIFIED || role == TASK_DEFAULT_APPLICATION) &&
+	    thread_get_perfcontrol_class(thread) == PERFCONTROL_CLASS_REALTIME) {
