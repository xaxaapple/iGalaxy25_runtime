+/*
+ * 0075 (host-overhead, 2026-11-15): the kernel's leaf entry of va as it is now (0 outside the kernel's own range), for
+ * pmap_enter's hook: an entry made again exactly as it was (the VM enters wired kernel pages again on a wire, a fault on a
+ * kernel object, a protection it already has) has its host mapping already. That mapping was made when the entry was
+ * (hosted_kernel_enter) and goes only with a flush, which maps a still valid entry again at once
+ * (hosted_tlb_flush_region), so an unchanged valid entry is mapped: no mmap in xnuhost (each one with xnuhost's mmap_lock
+ * taken for writing, which stops every vCPU's page faults meanwhile). An entry made before the host layer was up is
+ * filled at its first fault (hosted_kernel_fill), as before.
+ */
+/* hosted_kernel_enters_same: declared with the other counters, above */
+pt_entry_t hosted_kernel_pte(uint64_t va);
+pt_entry_t
+hosted_kernel_pte(uint64_t va)
+{
+	va &= ~(uint64_t)ARM_PGMASK;
+	if (va < hosted_kva_base || va >= hosted_kva_end || kernel_pmap->tte == NULL) {
+		return 0;
+	}
+	return hosted_walk(kernel_pmap, va);
+}
+
+bool hosted_kernel_enter_same(uint64_t va, pt_entry_t before);
+bool
+hosted_kernel_enter_same(uint64_t va, pt_entry_t before)
+{
+	if (before == 0 || hosted_pte_prot(before, false) == 0 || hosted_kernel_pte(va) != before) {
+		return false;
+	}
+	os_atomic_inc(&hosted_kernel_enters_same, relaxed);
+	return true;
+}
