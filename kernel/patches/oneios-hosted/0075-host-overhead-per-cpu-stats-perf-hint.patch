+{
+	uint32_t hint = XH_HINT_VALID;
+	switch (thread_get_perfcontrol_class(thread)) {
+	case PERFCONTROL_CLASS_REALTIME:
+		hint |= XH_HINT_REALTIME | XH_HINT_UI | 1024;
+		break;
+	case PERFCONTROL_CLASS_UI:
+	case PERFCONTROL_CLASS_ABOVEUI:
+		hint |= XH_HINT_UI | 1024;
+		break;
+	case PERFCONTROL_CLASS_USER_INITIATED:
+		hint |= XH_HINT_UI | 768;
+		break;
+	case PERFCONTROL_CLASS_BACKGROUND:
+	case PERFCONTROL_CLASS_UTILITY:
+		hint |= XH_HINT_BACKGROUND;
+		break;
+	default:
+		break;
+	}
+	if (!(hint & XH_HINT_UI) && proc_get_effective_thread_policy(thread, TASK_POLICY_DARWIN_BG)) {
+		hint = XH_HINT_VALID | XH_HINT_BACKGROUND;
+	}
+	struct xh_cpu *cpu = hosted_cpu();
+	if (cpu->perf_hint != hint) {
+		cpu->perf_hint = hint;
+		hosted_user_stats.hints++;
+	}
+}
